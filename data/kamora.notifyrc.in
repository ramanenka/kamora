[Global]
IconName=@KAMORA_APP_ID@
Name=@KAMORA_APP_NAME@
Comment=Scheduled borg backups to a USB drive
DesktopEntry=@KAMORA_APP_ID@

[Event/backupDue]
Name=Backup due
Comment=A backup is due
IconName=state-warning
Action=Popup

[Event/backupFinished]
Name=Backup finished
Comment=A backup completed successfully
IconName=state-ok
Action=Popup

[Event/backupFailed]
Name=Backup failed
Comment=A backup did not finish
IconName=state-error
Urgency=Critical
Action=Popup
